{
  "name": "beyza-security",
  "version": "0.1.0",
  "private": true,
  "description": "Beyza Security - Dutch field-service AI operating system for Dordrecht Hovenier / Onderhoudbedrijf",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",

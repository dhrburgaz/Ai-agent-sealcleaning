    "typescript": "5.6.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.19.2",
    "vitest": "5.0.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "prettier": "3.3.3",

# Beyza Security - environment configuration
# Copy to .env.local for local development. Never commit real secrets.

# --- Core ---
NODE_ENV=development
DATABASE_PATH=./storage/beyza.db

# Session secret: must be >= 32 characters. Generate with `openssl rand -hex 32`.
SESSION_SECRET=change-this-to-a-random-32-plus-character-secret

# --- AI budget (see docs/AI_COST_CONTROL.md) ---
# Default paid AI budget is 0. The system remains fully useful with no AI keys.
AI_MONTHLY_BUDGET_EUR=0
AI_DAILY_BUDGET_EUR=0

# --- Optional AI providers (all optional, all disabled unless a key is set) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional calendar connectors (Phase 7, not required) ---
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
